# Flask
FLASK_ENV=production
SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-a-random-string

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgresql://inspection:inspection@localhost:5432/inspection

# Redis (for rate limiting in production)
REDIS_URL=redis://localhost:6379/0

# File uploads
UPLOAD_FOLDER=instance/uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=instance/logs/app.log

# Gunicorn
GUNICORN_BIND=0.0.0.0:5000
GUNICORN_WORKERS=4
GUNICORN_THREADS=4

# CORS (comma-separated allowed origins, or * for all)
CORS_ORIGINS=https://yourdomain.com

# Server port (dev mode)
PORT=5001

# OpenAI (for auto-translation English → Arabic)
OPENAI_API_KEY=your-openai-api-key
OPENAI_TRANSLATE_MODEL=gpt-4o-mini

# --- SAP file courier (Windows terminal PC) ---
# Shared secret the courier sends with every upload. Machine-to-machine.
SAP_SYNC_ROBOT_KEY=

# --- Telegram planning bot ---
# From BotFather. Absent means the bot cannot send and the webhook refuses
# everything — a missing token must never mean "open to all".
TELEGRAM_BOT_TOKEN=
# Used twice: last path segment of the webhook URL, and the header Telegram
# echoes back. Any long random string.
TELEGRAM_WEBHOOK_SECRET=
# "<telegram_user_id>:<app_user_id>,..." — one setting doing both
# authorization and identity. Anyone not listed is ignored in silence.
TELEGRAM_ALLOWED_USERS=
# Kill switch. false skips blueprint registration entirely.
TELEGRAM_ENABLED=true
